<!-- Un domaine libvirt réduit à l'essentiel : le squelette qu'on retrouve
     dans tout « virsh dumpxml », débarrassé de ce que libvirt complète seul
     (uuid, adresse MAC, adresses PCI, contrôleurs).
     Le disque est désigné par son chemin, dans le pool default
     (/var/lib/libvirt/images), comme dans la définition d'une VM créée par
     virt-install : l'option remove-all-storage de virsh undefine retrouve le
     volume à ce chemin et le supprime.
     On n'écrit pas <disk type="volume"> avec pool et volume : sur Ubuntu 24.04,
     libvirt 10.0 écrit le profil AppArmor du domaine avant de traduire le
     volume en chemin ; le chemin du disque n'y figure pas, et QEMU, confiné,
     échoue en « Permission denied ». Debian 13 (libvirt 11.3) a le même ordre
     dans son code ; le défaut n'y a pas été observé.
     Sans élément loader ni firmware="efi", la VM démarre en BIOS : les
     instantanés internes (virsh snapshot-create-as) restent possibles. -->
<domain type="kvm">
  <name>vm-exemple</name>
  <memory unit="MiB">2048</memory>
  <vcpu>2</vcpu>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <boot dev="hd"/>
  </os>
  <features>
    <!-- sans ACPI, l'invité n'entend pas « virsh shutdown » -->
    <acpi/>
  </features>
  <devices>
    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <source file="/var/lib/libvirt/images/vm-exemple.qcow2"/>
      <target dev="vda" bus="virtio"/>
    </disk>
    <interface type="network">
      <source network="default"/>
      <model type="virtio"/>
    </interface>
    <console type="pty"/>
    <graphics type="vnc"/>
  </devices>
</domain>
