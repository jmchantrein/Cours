$ cd ~/atelier
# man ls, puis /size et n : l'option -S trie par taille ; -r inverse l'ordre ;
# -h écrit les tailles en Kio, Mio (avec -l)
$ ls -lS journaux
total 80
-rw-r--r-- 1 ada ada 72375 Sep  1 08:00 serveur-2026-novembre.log
-rw-r--r-- 1 ada ada  5790 Sep  1 08:00 serveur-2025-novembre.log
$ ls -lSr journaux
total 80
-rw-r--r-- 1 ada ada  5790 Sep  1 08:00 serveur-2025-novembre.log
-rw-r--r-- 1 ada ada 72375 Sep  1 08:00 serveur-2026-novembre.log
$ ls -lh journaux
total 80K
-rw-r--r-- 1 ada ada 5.7K Sep  1 08:00 serveur-2025-novembre.log
-rw-r--r-- 1 ada ada  71K Sep  1 08:00 serveur-2026-novembre.log
