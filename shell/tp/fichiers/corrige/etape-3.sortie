$ cd ~/fichiers
$ stat -c '%a %A %n' pionnieres.csv scripts/sauvegarde.sh documents/notes
644 -rw-r--r-- pionnieres.csv
644 -rw-r--r-- scripts/sauvegarde.sh
755 drwxr-xr-x documents/notes
# rw- r-- --- : 4+2, 4, 0
$ chmod 640 pionnieres.csv
# rwx r-x --- : 4+2+1, 4+1, 0
$ chmod 750 scripts/sauvegarde.sh
# rwx --- --- : 7, 0, 0
$ chmod 700 documents/notes
$ stat -c '%a %A %n' pionnieres.csv scripts/sauvegarde.sh documents/notes
640 -rw-r----- pionnieres.csv
750 -rwxr-x--- scripts/sauvegarde.sh
700 drwx------ documents/notes
