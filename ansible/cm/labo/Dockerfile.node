# Nœud géré du labo du cours : un serveur SSH et Python, aucun agent.
# python3-apt : utilisé par le module ansible.builtin.apt. Les listes de paquets
# sont gardées, pour installer sans update_cache.
FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
      openssh-server python3 python3-apt procps \
    && mkdir -p /run/sshd
CMD ["/usr/sbin/sshd", "-D"]
